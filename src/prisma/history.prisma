model ShopHistory {
    userId    String   @db.Uuid
    shopId    String   @db.Uuid
    shop      Shop     @relation(fields: [shopId], references: [id])
    createdAt DateTime @default(now())
    @@id([userId, shopId])
}

model ShopFavourite {
    userId    String   @db.Uuid
    shopId    String   @db.Uuid
    shop      Shop     @relation(fields: [shopId], references: [id])
    createdAt DateTime @default(now())
    @@id([userId, shopId])
}

model ItemHistory {
    userId    String   @db.Uuid
    itemId    String   @db.Uuid
    item      Item     @relation(fields: [itemId], references: [id])
    createdAt DateTime @default(now())
    @@id([userId, itemId])
}

model ItemFavourite {
    userId    String   @db.Uuid
    itemId    String   @db.Uuid
    item      Item     @relation(fields: [itemId], references: [id])
    createdAt DateTime @default(now())
    @@id([userId, itemId])
}

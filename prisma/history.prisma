enum RecordType {
    HISTORY
    FAVORITE
}

model ShopRecord {
    userId    String   @db.Uuid
    shopId    String   @db.Uuid
    type      RecordType
    createdAt DateTime @default(now())
    @@id([userId, shopId])
}

model ItemRecord {
    userId    String   @db.Uuid
    itemId    String   @db.Uuid
    type      RecordType
    createdAt DateTime @default(now())
    @@id([userId, itemId])
}


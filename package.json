{
  "name": "baoleme-backend-microservice",
  "version": "1.0.0",
  "description": "My Moleculer-based microservices project",
  "scripts": {
    "build": "tsc -p .",
    "dev": "npx tsx ./node_modules/moleculer/bin/moleculer-runner.js --env --config moleculer.config.ts --hot --repl services/**/*.service.ts",
    "start": "moleculer-runner --env --config out/moleculer.config.js",
    "cli": "moleculer connect NATS",
    "test:integration": "jest tests/integration --verbose --setupFilesAfterEnv=./tests/integration/setup.ts --runInBand",
    "test:integration:watch": "jest tests/integration --watch --verbose --setupFilesAfterEnv=./tests/integration/setup.ts --runInBand",
    "dc:up": "docker-compose up --build -d",
    "dc:logs": "docker-compose logs -f",
    "dc:down": "docker-compose down"
  },
  "keywords": [
    "microservices",
    "moleculer"
  ],
  "author": "",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.1",
    "@types/smtp-server": "^3.5.12",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "jest-cli": "^27.5.1",
    "mailparser": "^3.7.4",
    "moleculer-repl": "^0.7.3",
    "smtp-server": "^3.14.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcrypt": "^6.0.0",
    "connect-history-api-fallback": "^2.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "haversine-distance": "^1.2.4",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.5",
    "moleculer": "^0.14.26",
    "moleculer-web": "^0.10.4",
    "nats": "^2.7.1",
    "nodemailer": "^7.0.5",
    "prisma": "^6.15.0",
    "ramda-adjunct": "^5.1.0",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">= 16.x.x"
  },
  "prisma": {
    "schema": "./prisma"
  }
}
